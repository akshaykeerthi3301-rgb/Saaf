{
  "manifest_version": 3,
  "name": "Saaf \u2014 score any job posting",
  "version": "0.2.0",
  "description": "Score any job posting against your resume, see the missing keywords, and fill the application form. Never submits. Reads only the page you are on.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.workable.com/*",
    "https://*.recruitee.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.wd1.myworkdayjobs.com/*",
    "https://*.wd3.myworkdayjobs.com/*",
    "https://*.wd5.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.brassring.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.breezy.hr/*",
    "https://*.teamtailor.com/*",
    "https://*.personio.de/*",
    "https://*.pinpointhq.com/*",
    "https://*.rippling.com/*",
    "https://*.zohorecruit.com/*",
    "https://*.keka.com/*",
    "https://*.darwinbox.in/*",
    "https://*.freshteam.com/*",
    "https://saaf-ten.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.workable.com/*",
        "https://*.recruitee.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.wd1.myworkdayjobs.com/*",
        "https://*.wd3.myworkdayjobs.com/*",
        "https://*.wd5.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.brassring.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.teamtailor.com/*",
        "https://*.personio.de/*",
        "https://*.pinpointhq.com/*",
        "https://*.rippling.com/*",
        "https://*.zohorecruit.com/*",
        "https://*.keka.com/*",
        "https://*.darwinbox.in/*",
        "https://*.freshteam.com/*"
      ],
      "js": [
        "autofill.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Saaf",
    "default_popup": "popup.html"
  }
}
