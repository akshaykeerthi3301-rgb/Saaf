# Public by design — safe *because* RLS holds on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER set this in Vercel or any NEXT_PUBLIC_* variable.
# GitHub Actions secrets only — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
# Region-specific ingest host — note the 'i.':
#   us.posthog.com  -> https://us.i.posthog.com
#   eu.posthog.com  -> https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

RESEND_API_KEY=
SENTRY_DSN=
# Same DSN, client side. A DSN is public by design — it can only write.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
