# Public by design — safe *because* RLS holds on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER set this in Vercel or any NEXT_PUBLIC_* variable.
# GitHub Actions secrets only — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

RESEND_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
